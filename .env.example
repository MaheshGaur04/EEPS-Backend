DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
# Set DATABASE_URL to use a single PostgreSQL connection URL, or configure the
# DB_* variables below. DATABASE_URL takes precedence unless USE_SQLITE=True.
DATABASE_URL=
DB_NAME=earth_energy
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# JWT (access in Authorization header, refresh in httpOnly cookie `jwt`)
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret

FRONTEND_URL=http://localhost:3000
# Optional comma-separated additional frontend origins (for example Vercel previews).
CORS_ALLOWED_ORIGINS=
# Use None for separate frontend/backend hostnames; requires HTTPS.
REFRESH_COOKIE_SAMESITE=Strict

# Gemini ROI (optional; heuristic used if missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional SMTP for status emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@earthenergy.local
COMPANY_NAME=Earth Solutions
